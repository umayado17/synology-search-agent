def config_path_from(environ):
    return (environ.get("UNISEARCH_CONFIG")
            or os.path.join(os.path.expanduser("~"), ".config", "unisearch", "server.conf"))


def human_seconds(seconds):
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds and seconds % size == 0:
            return "%d%s" % (seconds // size, unit)
    return "%ds" % seconds


def convert_setting(name, value, spec, where):
    _, kind, low, high = spec
    if kind == "language":
        lang = value.lower()
        if lang not in LANGUAGES:
            raise CliError("config", t("%s: lang は ja か en", "%s: lang must be ja or en")
                           % where, EXIT_USAGE)
        return lang
    number = parse_duration(value) if kind == "duration" else (
        int(value) if value.isdigit() else None)
    if number is None or not low <= number <= high:
        if kind == "duration":
            limits = t("%s〜%s（例 8h, 30m, 7d）", "%s to %s (e.g. 8h, 30m, 7d)") % (
                human_seconds(low) if low else "0", human_seconds(high))
        else:
            limits = t("%d〜%d の整数", "an integer from %d to %d") % (low, high)
        raise CliError("config", t("%s: %s は %s", "%s: %s must be %s") % (where, name, limits),
                       EXIT_USAGE)
    return number


def load_settings(path, spec=None):
    """設定ファイルを読み、既定値と合わせた値（秒・件数）を返す。ファイルが無ければ既定値。"""
    spec = spec or SERVER_SETTINGS
    values = {name: item[0] for name, item in spec.items()}
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except FileNotFoundError:
        lines = []
    except OSError:
        raise CliError("config", t("設定ファイルを読めません: %s", "Cannot read the settings file: %s")
                       % path, EXIT_USAGE)
    for number, line in enumerate(lines, start=1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise CliError("config", t("%s の %d 行目: `名前 = 値` の形で書いてください",
                                       "%s line %d: write it as `name = value`")
                           % (path, number), EXIT_USAGE)
        name, value = (part.strip() for part in line.split("=", 1))
        name = name.lower()
        if any(word in name for word in SECRET_WORDS):
            raise CliError("config", t("%s の %d 行目: 設定ファイルにパスワード・OTP・SID などは"
                                       "書けません",
                                       "%s line %d: passwords, OTPs, SIDs and the like cannot "
                                       "go in the settings file") % (path, number), EXIT_USAGE)
        if name not in spec:
            raise CliError("config", t("%s の %d 行目: 知らない設定名です: %s（使えるもの: %s）",
                                       "%s line %d: unknown setting: %s (known: %s)")
                           % (path, number, sanitize_text(name), ", ".join(sorted(spec))),
                           EXIT_USAGE)
        values[name] = value
    return {name: convert_setting(name, values[name], spec[name], path) for name in spec}


def search_time_limit(scan_time_budget, http_timeout):
    """検索セッションで1回の検索にかかる最長の秒数。

    読み進めるのは scan_time_budget 秒までで、最後に始めた API 呼び出しも http_timeout 秒で
    打ち切られるので、これを超えない。
    """
    return scan_time_budget + http_timeout + GATEWAY_MARGIN


def gateway_wait():
    """入口が検索セッションの応答を待つ秒数。

    検索セッションの実際の値（session start の --timeout や、開始後に書き換えた設定ファイル）
    に左右されないよう、設定でとれる最大値から決める。
    """
    return search_time_limit(SERVER_SETTINGS["scan_time_budget"][3],
                             SERVER_SETTINGS["http_timeout"][3])


# ---------------------------------------------------------------- CLI

class _Parser(argparse.ArgumentParser):
    def error(self, message):
        self.print_usage(sys.stderr)
        print(t("%s: エラー: %s", "%s: error: %s") % (self.prog, message), file=sys.stderr)
        sys.exit(EXIT_USAGE)


def build_parser():
    parser = _Parser(
        prog="unisearch",
        description=t("Synology Universal SearchをSSHから検索（sudo不要・対話認証）",
                      "Search Synology Universal Search over SSH (no sudo, interactive login)"))
    parser.add_argument("query", nargs="?", help=t("検索語", "search words"))
    parser.add_argument("--limit", type=int, default=10,
                        help=t("取得件数（1〜100、既定10）", "number of results (1-100, default 10)"))
    parser.add_argument("--offset", type=int, default=0,
                        help=t("開始位置（0以上、既定0）", "start position (0 or more, default 0)"))
    parser.add_argument("--json", action="store_true",
                        help=t("結果をJSONで出力（docs/cli-spec.md）",
                               "print the result as JSON (docs/cli-spec.md)"))
    parser.add_argument("--raw", action="store_true",
                        help=t("APIの data をそのままJSON出力（実機の応答形式検証用）",
                               "print the API data as is (to check the real response format)"))
    parser.add_argument("--user", help=t("DSMユーザー名（省略時は対話入力）",
                                         "DSM user name (asked interactively if omitted)"))
    parser.add_argument("--timeout", type=float,
                        help=t("HTTPタイムアウト秒（既定は設定ファイルの http_timeout、無ければ45）",
                               "HTTP timeout in seconds (default: http_timeout in the settings "
                               "file, else 45)"))
    parser.add_argument("--allow-prefix", action="append", default=[], metavar="PATH",
                        help=t("この共有パス（例 /archive）配下の結果だけを出す。複数指定可。"
                               "DSM の権限設定に加える多層防御",
                               "show only results under this share path (e.g. /archive); "
                               "repeatable; an extra layer on top of DSM permissions"))
    parser.add_argument("--no-session", action="store_true",
                        help=t("検索セッションが動いていても使わず、対話ログインで検索する",
                               "log in interactively even if a search session is running"))
    parser.add_argument("--check-api", action="store_true",
                        help=t("認証なしで必要APIの有無とバージョンを確認して終了",
                               "check the required APIs and versions without logging in, "
                               "then exit"))
    parser.add_argument("--version", action="version", version="%(prog)s " + VERSION)
    return parser


def prefix_error():
    return t("--allow-prefix は / で始まる共有パス（/ 単独や .. は不可）: %s",
             "--allow-prefix must be a share path starting with / (not / alone, no ..): %s")


def validate_args(parser, args):
    if args.check_api:
        return
    if args.query is None or args.query.strip() == "":
        parser.error(t("検索語を指定してください", "give search words"))
    if not (1 <= args.limit <= 100):
        parser.error(t("--limit は1〜100", "--limit must be 1-100"))
    if args.offset < 0:
        parser.error(t("--offset は0以上", "--offset must be 0 or more"))
    if args.timeout is not None and not (0 < args.timeout <= 600):
        parser.error(t("--timeout は0より大きく600以下", "--timeout must be more than 0 and at most 600"))
    prefixes = []
    for prefix in args.allow_prefix:
        cleaned = normalize_prefix(prefix)
        if cleaned is None:
            parser.error(prefix_error() % prefix)
        prefixes.append(cleaned)
    args.allow_prefix = prefixes
    if prefixes and args.raw:
        parser.error(t("--raw は絞り込みをしないため --allow-prefix と併用できません",
                        "--raw does not filter, so it cannot be used with --allow-prefix"))


def restrict_result(result, prefixes):
    """待機役から受け取った結果を、さらに狭い接頭辞で絞る（広げることはできない）。"""
    hits = [hit for hit in result.get("hits", [])
            if isinstance(hit, dict) and path_allowed(hit.get("share_path"), prefixes)]
    narrowed = dict(result)
    narrowed["hits"] = hits
    narrowed["returned"] = len(hits)
    narrowed["total"] = None
    return narrowed


def wants_session(args, socket_path):
    """待機役が動いていて、対話専用の指定が無ければ待機役を使う。"""
    if args.no_session or args.raw or args.user:
        return False
    return os.path.exists(socket_path)


def run(args, transport, prompter, stdout, stderr, socket_path):
    as_json = args.json or args.raw or args.check_api
    if args.check_api:
        report = check_api(transport)
        print(json.dumps(report, ensure_ascii=False), file=stdout)
        return EXIT_OK if report["ok"] else EXIT_RESPONSE

    if wants_session(args, socket_path):
        response = broker_request(socket_path, {
            "op": "search", "query": args.query,
            "limit": args.limit, "offset": args.offset}, args.session_wait)
        result = response.get("result")
        if not isinstance(result, dict):
            raise CliError("response", session_format_error(), EXIT_RESPONSE)
        if args.allow_prefix:
            result = restrict_result(result, args.allow_prefix)
        if as_json:
            print(json.dumps(result, ensure_ascii=False), file=stdout)
        else:
            print(format_text(result), file=stdout)
        return EXIT_OK

    username = args.user or prompter.username()
    if not username:
        raise CliError("usage", t("ユーザー名が空です", "The user name is empty"), EXIT_USAGE)
    password, otp = ask_credentials(prompter, username, t("検索", "search"))
    sid = None
    try:
        sid = login(transport, username, password, otp)
        password = otp = None
        if args.allow_prefix:
            result = search_filtered(transport, sid, args.query, args.limit, args.offset,
                                     args.allow_prefix)
        else:
            data = search(transport, sid, args.query, args.limit, args.offset)
            result = None if args.raw else build_result(
                args.query, args.limit, args.offset, data)
    finally:
        password = otp = None
        if sid and not logout(transport, sid):
            print(t("警告: ログアウトを確認できませんでした", "Warning: could not confirm the logout"),
                  file=stderr)
        sid = None

    if args.raw:
        print(json.dumps({"schema_version": SCHEMA_VERSION, "query": args.query,
                          "raw": data}, ensure_ascii=False), file=stdout)
    else:
        if as_json:
            print(json.dumps(result, ensure_ascii=False), file=stdout)
        else:
            print(format_text(result), file=stdout)
    return EXIT_OK


# ---------------------------------------------------------------- 検索セッション（待機役）
#
# 本人が TTY で一度ログインし、SID をこのプロセスのメモリにだけ保持する。
# UNIX ソケット（ディレクトリ 0700・ソケット 0600・同一UIDのみ）で「検索」「状態」「停止」
# だけを受け付ける。SID はファイルにもソケット応答にも出さない。
# 設計: docs/design-noninteractive-auth.md

LONG_SESSION = 24 * 3600  # これより長いと、DSM 側で先に切れる可能性を表示する
MAX_CONSECUTIVE_FAILURES = 3
MAX_REQUEST_BYTES = 64 * 1024
MAX_RESPONSE_BYTES = 16 * 1024 * 1024
MAX_QUERY_CHARS = 1000
MAX_OFFSET = 100000
SOCKET_NAME = "broker.sock"
LOG_NAME = "broker.log"
KEEPALIVE_QUERY = "keepalive"


def state_dir_from(environ):
    return (environ.get("UNISEARCH_STATE_DIR")
            or os.path.join(os.path.expanduser("~"), ".unisearch"))


def socket_path_in(state_dir):
    return os.path.join(state_dir, SOCKET_NAME)


def utc_text(seconds):
    return datetime.datetime.fromtimestamp(
        seconds, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_duration(text):
    """'7d' '8h' '30m' '45s' '3600' を秒に。不正なら None。"""
    if not isinstance(text, str) or not text:
        return None
    units = {"d": 86400, "h": 3600, "m": 60, "s": 1}
    unit = 1
    if text[-1] in units:
        unit = units[text[-1]]
        text = text[:-1]
    if not text.isdigit():
        return None
    return int(text) * unit


def is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def session_required_error():
    return CliError(
        "session_required",
        t("検索セッションがありません。本人が ssh -t で `unisearch session start` を実行してください",
          "No search session. A person must run `unisearch session start` over ssh -t"),
        EXIT_SESSION_REQUIRED)


def session_format_error():
    return t("検索セッションの応答形式が想定外です", "Unexpected response format from the search session")


def session_running_error():
    return CliError("session_running",
                    t("検索セッションはすでに動いています（unisearch session status）",
                      "A search session is already running (unisearch session status)"),
                    EXIT_SESSION_STATE)


def error_payload(error):
    return {"ok": False, "error": {
        "type": error.kind, "message": error.message,
        "api_code": error.api_code, "exit_code": error.exit_code}}


def ensure_private_dir(path):
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        raise CliError("state", t("状態ディレクトリが自分所有のディレクトリではありません: %s",
                                  "The state directory is not a directory you own: %s") % path,
                       EXIT_SESSION_STATE)
    if stat.S_IMODE(info.st_mode) & 0o077:
        os.chmod(path, 0o700)


def peer_uid(conn):
    option = getattr(socket, "SO_PEERCRED", None)
    if option is None:
        return None  # Linux 以外（開発用 macOS など）。ソケットの 0600 で守る
    data = conn.getsockopt(socket.SOL_SOCKET, option, struct.calcsize("3i"))
    return struct.unpack("3i", data)[1]


def recv_line(conn, limit):
    chunks = []
    size = 0
    while True:
        chunk = conn.recv(65536)
        if not chunk:
            break
        chunks.append(chunk)
        size += len(chunk)
        if size > limit:
            raise ValueError("too large")
        if b"\n" in chunk:
            break
    return b"".join(chunks).split(b"\n", 1)[0]


def socket_is_live(path):
    probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    probe.settimeout(2)
    try:
        probe.connect(path)
        return True
    except OSError:
        return False
    finally:
        probe.close()


def create_listener(path):
    if os.path.lexists(path):
        if socket_is_live(path):
            raise session_running_error()
        if not stat.S_ISSOCK(os.lstat(path).st_mode):
            raise CliError("state", t("ソケットの位置に別のファイルがあります: %s",
                                      "Another file is where the socket should be: %s") % path,
                           EXIT_SESSION_STATE)
        os.unlink(path)  # 前回の異常終了で残った古いソケット
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    old_umask = os.umask(0o177)
    try:
        listener.bind(path)
    finally:
        os.umask(old_umask)
    os.chmod(path, 0o600)
    listener.listen(8)
    return listener


def make_logger(path):
    """イベントと件数だけを記録する。検索語・SID・資格情報は書かない。"""
    def log(event, **fields):
        record = {"time": utc_text(time.time()), "event": event}
        record.update(fields)
        try:
            fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
            with os.fdopen(fd, "a", encoding="utf-8") as handle:
                handle.write(json.dumps(record, ensure_ascii=False) + "\n")
        except OSError:
            pass
    return log


class Broker:
    def __init__(self, transport, sid, allow_prefixes, max_age, keepalive,
                 clock=time.time, log=None, scan_time_budget=None, scan_max_pages=None):
        self.transport = transport
        self._sid = sid
        self.allow_prefixes = list(allow_prefixes)
        self.clock = clock
        self.started_at = clock()
        self.expires_at = self.started_at + max_age
        self.keepalive = keepalive
        self.last_keepalive = self.started_at
        self.searches = 0
        self.failures = 0
        self.last_error = None
        self.stopping = False
        self.stop_reason = None
        self.log = log or (lambda event, **fields: None)
        self.scan_time_budget = scan_time_budget or SCAN_TIME_BUDGET
        self.scan_max_pages = scan_max_pages or MAX_SCAN_PAGES
        self.checkpoints = {}  # 続きのページ用。検索語 → (許可範囲内で読んだ件数, API の位置)

    def status(self):
        return {
            "started_utc": utc_text(self.started_at),
            "expires_utc": utc_text(self.expires_at),
            "remaining_seconds": max(0, int(self.expires_at - self.clock())),
            "allow_prefixes": list(self.allow_prefixes),
            "searches": self.searches,
            "consecutive_failures": self.failures,
            "last_error": self.last_error,
        }

    def stop(self, reason):
        if not self.stopping:
            self.stopping = True
            self.stop_reason = reason

    def _record_failure(self, error):
        self.failures += 1
        self.last_error = {"type": error.kind, "api_code": error.api_code}
        if self.failures >= MAX_CONSECUTIVE_FAILURES:
            # 連続失敗はセッション失効などが疑われるが原因は断定しない。安全側に倒して終了する。
            self.stop("consecutive_failures")

    def handle(self, request):
        if not isinstance(request, dict):
            return error_payload(CliError("usage", t("要求の形式が不正です", "Bad request format"),
                                          EXIT_USAGE))
        op = request.get("op")
        if op == "status":
            return {"ok": True, "status": self.status()}
        if op == "stop":
            self.stop("requested")
            return {"ok": True}
        if op == "search":
            return self._search(request)
        return error_payload(CliError("usage", t("未対応の操作です", "Unsupported operation"), EXIT_USAGE))

    def _search(self, request):
        if self.clock() >= self.expires_at:
            self.stop("expired")
            return error_payload(session_required_error())
        query = request.get("query")
        limit = request.get("limit", 10)
        offset = request.get("offset", 0)
        if not isinstance(query, str) or not query.strip() or len(query) > MAX_QUERY_CHARS:
            return error_payload(CliError("usage", bad_query_error(), EXIT_USAGE))
        if not is_int(limit) or not 1 <= limit <= 100:
            return error_payload(CliError("usage", t("limit は1〜100", "limit must be 1-100"), EXIT_USAGE))
        if not is_int(offset) or not 0 <= offset <= MAX_OFFSET:
            return error_payload(CliError("usage", t("offset は0〜%d", "offset must be 0-%d") % MAX_OFFSET,
                                          EXIT_USAGE))
        try:
            result = search_filtered(self.transport, self._sid, query, limit, offset,
                                     self.allow_prefixes, self.checkpoints,
                                     max_pages=self.scan_max_pages,
                                     time_budget=self.scan_time_budget)
        except CliError as exc:
            if exc.kind != "scan_limit":  # 読み進める上限に達しただけ。NAS の障害ではない
                self._record_failure(exc)
            self.log("search_failed", type=exc.kind, api_code=exc.api_code)
            return error_payload(exc)
        self.failures = 0
        self.searches += 1
        self.log("search", returned=result["returned"])
        return {"ok": True, "result": result}

    def tick(self):
        now = self.clock()
        if now >= self.expires_at:
            self.stop("expired")
            return
        if self.keepalive and now - self.last_keepalive >= self.keepalive:
            self.last_keepalive = now
            try:
                search(self.transport, self._sid, KEEPALIVE_QUERY, 1, 0)
                self.failures = 0
            except CliError as exc:
                self._record_failure(exc)
                self.log("keepalive_failed", type=exc.kind, api_code=exc.api_code)

    def serve_connection(self, conn):
        conn.settimeout(10)
        uid = peer_uid(conn)
        if uid is not None and uid != os.getuid():
            self.log("peer_rejected", uid=uid)
            return
        try:
            line = recv_line(conn, MAX_REQUEST_BYTES)
        except (ValueError, OSError):
            response = error_payload(CliError(
                "usage", t("要求が大きすぎるか読み取れません", "The request is too large or unreadable"),
                EXIT_USAGE))
        else:
            if not line.strip():
                return  # 生存確認の接続
            try:
                request = json.loads(line.decode("utf-8"))
            except (UnicodeDecodeError, ValueError):
                response = error_payload(CliError(
                    "usage", t("要求がJSONではありません", "The request is not JSON"), EXIT_USAGE))
            else:
                response = self.handle(request)
        try:
            conn.sendall((json.dumps(response, ensure_ascii=False) + "\n").encode("utf-8"))
        except OSError:
            pass

    def serve(self, listener):
        listener.settimeout(1.0)
        while not self.stopping:
            self.tick()
            if self.stopping:
                break
            try:
                conn, _ = listener.accept()
            except socket.timeout:
                continue
            except OSError:
                if self.stopping:
                    break
                raise
            with conn:
                self.serve_connection(conn)

    def close(self):
        ok = logout(self.transport, self._sid) if self._sid else True
        self._sid = None
        self.log("logout", ok=ok, reason=self.stop_reason)
        return ok


def run_broker(broker, listener, socket_path):
    broker.log("start", allow_prefixes=broker.allow_prefixes,
               expires_utc=utc_text(broker.expires_at))
    try:
        broker.serve(listener)
    finally:
        listener.close()
        try:
            os.unlink(socket_path)
        except OSError:
            pass
        broker.close()


def broker_request(socket_path, request, timeout):
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    try:
        try:
            client.connect(socket_path)
        except socket.timeout:
            raise CliError("network", t("検索セッションに接続できません（応答なし）",
                                         "Cannot connect to the search session (no answer)"),
                           EXIT_NETWORK)
        except OSError:
            raise session_required_error()
        client.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8"))
        line = recv_line(client, MAX_RESPONSE_BYTES)
    except socket.timeout:
        raise CliError("network", t("検索セッションの応答がありません",
                                     "No answer from the search session"), EXIT_NETWORK)
    except ValueError:
        raise CliError("response", t("検索セッションの応答が大きすぎます",
                                      "The search session answer is too large"), EXIT_RESPONSE)
    except OSError as exc:
        raise CliError("network", t("検索セッションとの通信に失敗しました（%s）",
                                    "Talking to the search session failed (%s)")
                       % type(exc).__name__, EXIT_NETWORK)
    finally:
        client.close()
    try:
        response = json.loads(line.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise CliError("response", t("検索セッションの応答がJSONではありません",
                                      "The search session answer is not JSON"), EXIT_RESPONSE)
    if not isinstance(response, dict) or "ok" not in response:
        raise CliError("response", session_format_error(), EXIT_RESPONSE)
    if not response["ok"]:
        error = response.get("error") if isinstance(response.get("error"), dict) else {}
        code = error.get("exit_code")
        raise CliError(str(error.get("type", "api")), str(error.get("message", "")),
                       code if is_int(code) and 1 <= code <= 130 else EXIT_API,
                       error.get("api_code"))
    return response


def build_session_parser():
    parser = _Parser(prog="unisearch session",
                     description=t("検索セッション（本人が一度ログインし、期限まで検索だけを受け付ける）",
                                   "Search session (a person logs in once; it accepts only "
                                   "searches until it expires)"))
    sub = parser.add_subparsers(dest="action")
    sub.required = True
    start = sub.add_parser("start", help=t("ログインしてセッションを開始（TTY必須）",
                                           "log in and start the session (needs a TTY)"))
    start.add_argument("--allow-prefix", action="append", default=[], metavar="PATH",
                       required=True,
                       help=t("検索結果を出す共有パス（例 /archive）。必須・複数可",
                              "share path whose results are shown (e.g. /archive); "
                              "required, repeatable"))
    start.add_argument("--user", help=t("DSMユーザー名（省略時は対話入力）",
                                        "DSM user name (asked interactively if omitted)"))
    start.add_argument("--max-age",
                       help=t("有効期間（例 8h, 30m, 7d。1m〜90d。既定は設定ファイル、無ければ 8h）",
                              "how long it lasts (e.g. 8h, 30m, 7d; 1m-90d; default: the "
                              "settings file, else 8h)"))
    start.add_argument("--keepalive",
                       help=t("セッション維持の検索間隔（例 10m。0で無効。既定は設定ファイル、無ければ 10m）",
                              "interval of keep-alive searches (e.g. 10m; 0 turns it off; "
                              "default: the settings file, else 10m)"))
    start.add_argument("--timeout", type=float,
                       help=t("HTTPタイムアウト秒（既定は設定ファイル、無ければ45）",
                              "HTTP timeout in seconds (default: the settings file, else 45)"))
    start.add_argument("--foreground", action="store_true",
                       help=t("バックグラウンドに回らずこの端末で動かす（検証用）",
                              "run in this terminal instead of the background (for testing)"))
    status = sub.add_parser("status", help=t("セッションの状態を表示", "show the session state"))
    status.add_argument("--json", action="store_true")
    sub.add_parser("stop", help=t("セッションを終了してログアウト", "stop the session and log out"))
    return parser


def detach_and_serve(broker, listener, socket_path):
    """子プロセスで端末から切り離して待機役を動かす。戻らない。"""
    code = 0
    try:
        os.setsid()
        signal.signal(signal.SIGHUP, signal.SIG_IGN)
        signal.signal(signal.SIGTERM, lambda signum, frame: broker.stop("signal"))
        signal.signal(signal.SIGINT, lambda signum, frame: broker.stop("signal"))
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        run_broker(broker, listener, socket_path)
    except BaseException:
        code = 1
    finally:
        os._exit(code)


def session_start(args, transport, prompter, stdout, state_dir, daemonize, settings):
    prefixes = []
    for prefix in args.allow_prefix:
        cleaned = normalize_prefix(prefix)
        if cleaned is None:
            raise CliError("usage", prefix_error() % prefix, EXIT_USAGE)
        prefixes.append(cleaned)
    max_age = settings["session_max_age"]
    if args.max_age is not None:
        max_age = convert_setting("--max-age", args.max_age,
                                  SERVER_SETTINGS["session_max_age"], t("引数", "argument"))
    keepalive = settings["session_keepalive"]
    if args.keepalive is not None:
        keepalive = parse_duration(args.keepalive)
    if keepalive is None or (keepalive != 0 and not 60 <= keepalive <= max_age):
        raise CliError("usage", t("keepalive は 0 または 1m〜有効期間",
                                  "keepalive must be 0 or from 1m to the session length"),
                       EXIT_USAGE)
    http_timeout = args.timeout if args.timeout is not None else settings["http_timeout"]
    if not 0 < http_timeout <= 120:
        raise CliError("usage", t("--timeout は0より大きく120以下",
                                  "--timeout must be more than 0 and at most 120"), EXIT_USAGE)

    ensure_private_dir(state_dir)
    socket_path = socket_path_in(state_dir)
    if os.path.lexists(socket_path) and socket_is_live(socket_path):
        raise session_running_error()

    transport = transport or HttpTransport(http_timeout)
    username = args.user or prompter.username()
    if not username:
        raise CliError("usage", t("ユーザー名が空です", "The user name is empty"), EXIT_USAGE)
    password, otp = ask_credentials(prompter, username,
                                   t("検索セッションの開始", "start a search session"))
    try:
        sid = login(transport, username, password, otp)
    finally:
        password = otp = None
    try:
        listener = create_listener(socket_path)
    except BaseException:
        logout(transport, sid)
        raise
    broker = Broker(transport, sid, prefixes, max_age, keepalive,
                    log=make_logger(os.path.join(state_dir, LOG_NAME)),
                    scan_time_budget=settings["scan_time_budget"],
                    scan_max_pages=settings["scan_max_pages"])
    sid = None
    print(t("検索セッションを開始しました。期限: %s（UTC）／対象: %s",
            "Search session started. Expires: %s (UTC) / Scope: %s")
          % (utc_text(broker.expires_at), ", ".join(prefixes)), file=stdout)
    print(t("1回の検索は最長 %d 秒です。エージェント側の待ち時間（nas-search の timeout）は"
            "これより長くしてください。",
            "One search takes at most %d seconds. Make the agent's wait time (the nas-search "
            "timeout) longer than this.")
          % search_time_limit(broker.scan_time_budget, http_timeout), file=stdout)
    if max_age > LONG_SESSION:
        print(t("注意: DSM 側のログインがこの期間もつかは確認されていません。"
                "DSM 側で先に切れた場合、検索が3回続けて失敗した時点でセッションを終了します。",
                "Note: it is not confirmed that the DSM login lasts this long. If DSM ends it "
                "first, the session stops after 3 searches in a row fail."),
              file=stdout)
    if hasattr(stdout, "flush"):
        stdout.flush()
    if not daemonize or args.foreground:
        run_broker(broker, listener, socket_path)
        return EXIT_OK
    if os.fork() == 0:
        detach_and_serve(broker, listener, socket_path)
    listener.close()  # 親は終了するだけ。ログアウトしない（子が保持している）
    return EXIT_OK


def session_main(argv, transport, prompter, stdout, stderr, state_dir, daemonize,
                 config_path):
    parser = build_session_parser()
    args = parser.parse_args(argv)
    as_json = getattr(args, "json", False)
    socket_path = socket_path_in(state_dir)
    try:
        if args.action == "start":
            return session_start(args, transport, prompter or TtyPrompter(), stdout,
                                 state_dir, daemonize, load_settings(config_path))
        if args.action == "status":
            status = broker_request(socket_path, {"op": "status"}, 15)["status"]
            if as_json:
                print(json.dumps({"schema_version": SCHEMA_VERSION, "session": status},
                                 ensure_ascii=False), file=stdout)
            else:
                print(t("検索セッション: 動作中／期限 %s（UTC、残り %d 分）／対象 %s／検索 %d 回",
                        "Search session: running / expires %s (UTC, %d min left) / scope %s / "
                        "%d searches")
                      % (status["expires_utc"], status["remaining_seconds"] // 60,
                         ", ".join(status["allow_prefixes"]), status["searches"]), file=stdout)
            return EXIT_OK
        broker_request(socket_path, {"op": "stop"}, 15)
        print(t("検索セッションを終了しました", "Search session stopped"), file=stdout)
        return EXIT_OK
    except CliError as exc:
        emit_error(exc, as_json, stderr)
        return exc.exit_code
    except KeyboardInterrupt:
        emit_error(CliError("interrupted", t("中断されました", "Interrupted"), EXIT_INTERRUPTED), as_json, stderr)
        return EXIT_INTERRUPTED
    except Exception as exc:  # 内容は出さない
        emit_error(CliError("internal", t("内部エラー（%s）", "Internal error (%s)") % type(exc).__name__, EXIT_INTERNAL),
                   as_json, stderr)
        return EXIT_INTERNAL


# ---------------------------------------------------------------- AIエージェント用の入口
#
# authorized_keys の command= から `unisearch --agent-gateway` として呼ばれる。
# SSH_ORIGINAL_COMMAND を解析し、次の2つだけを受け付ける（シェルは一切起動しない）:
#   search <検索語> [--limit N] [--offset N]
#   status
# 出力は常に JSON。資格情報の入力は求めない。

def gateway_usage():
    return t("使えるのは `search <検索語> [--limit N] [--offset N]` と `status` だけです",
             "Only `search <words> [--limit N] [--offset N]` and `status` are allowed")


def bad_query_error():
    return t("検索語が不正です", "Invalid search words")


class _GatewayParser(argparse.ArgumentParser):
    def error(self, message):
        raise CliError("usage", t("%s（%s）", "%s (%s)") % (gateway_usage(), message), EXIT_USAGE)


def parse_gateway_command(command):
    try:
        tokens = shlex.split(command or "")
    except ValueError:
        raise CliError("usage", gateway_usage(), EXIT_USAGE)
    if tokens == ["status"]:
        return "status", None
    if not tokens or tokens[0] != "search":
        raise CliError("usage", gateway_usage(), EXIT_USAGE)
    parser = _GatewayParser(prog="search", add_help=False, allow_abbrev=False)
    parser.add_argument("query")
    parser.add_argument("--limit", type=int, default=10)
    parser.add_argument("--offset", type=int, default=0)
    args = parser.parse_args(tokens[1:])
    if not args.query.strip() or len(args.query) > MAX_QUERY_CHARS:
        raise CliError("usage", bad_query_error(), EXIT_USAGE)
    if not 1 <= args.limit <= 100:
        raise CliError("usage", t("--limit は1〜100", "--limit must be 1-100"), EXIT_USAGE)
    if not 0 <= args.offset <= MAX_OFFSET:
        raise CliError("usage", t("--offset は0〜%d", "--offset must be 0-%d") % MAX_OFFSET, EXIT_USAGE)
    return "search", {"query": args.query, "limit": args.limit, "offset": args.offset}


def gateway_main(command, state_dir, stdout, stderr):
    # 設定ファイルからは lang だけを読む（main で済ませている）。待ち時間は gateway_wait() の固定値で、
    # 検索の中身は検索セッションが決める
    socket_path = socket_path_in(state_dir)
    try:
        op, params = parse_gateway_command(command)
        wait = gateway_wait()
        if op == "status":
            status = broker_request(socket_path, {"op": "status"}, 15)["status"]
            print(json.dumps({"schema_version": SCHEMA_VERSION, "session": status},
                             ensure_ascii=False), file=stdout)
            return EXIT_OK
        request = {"op": "search"}
        request.update(params)
        result = broker_request(socket_path, request, wait).get("result")
        if not isinstance(result, dict):
            raise CliError("response", session_format_error(), EXIT_RESPONSE)
        print(json.dumps(result, ensure_ascii=False), file=stdout)
        return EXIT_OK
    except CliError as exc:
        emit_error(exc, True, stderr)
        return exc.exit_code
    except Exception as exc:  # 内容は出さない
        emit_error(CliError("internal", t("内部エラー（%s）", "Internal error (%s)") % type(exc).__name__, EXIT_INTERNAL),
                   True, stderr)
        return EXIT_INTERNAL


# ---------------------------------------------------------------- 入口

def main(argv=None, transport=None, prompter=None, stdout=None, stderr=None,
         environ=None, daemonize=True):
    stdout = stdout or sys.stdout
    stderr = stderr or sys.stderr
    argv = list(sys.argv[1:] if argv is None else argv)
    environ = os.environ if environ is None else environ
    state_dir = state_dir_from(environ)
    config_path = config_path_from(environ)
    set_language(peek_language(config_path))
    if argv == ["--agent-gateway"]:
        return gateway_main(environ.get("SSH_ORIGINAL_COMMAND", ""), state_dir, stdout, stderr)
    if argv[:1] == ["session"]:
        return session_main(argv[1:], transport, prompter, stdout, stderr, state_dir, daemonize,
                            config_path)

    parser = build_parser()
    args = parser.parse_args(argv)
    validate_args(parser, args)
    as_json = args.json or args.raw or args.check_api
    prompter = prompter or TtyPrompter()
    try:
        settings = load_settings(config_path)
        if args.timeout is None:
            args.timeout = settings["http_timeout"]
        args.session_wait = gateway_wait()
        transport = transport or HttpTransport(args.timeout)
        return run(args, transport, prompter, stdout, stderr, socket_path_in(state_dir))
    except CliError as exc:
        emit_error(exc, as_json, stderr)
        return exc.exit_code
    except KeyboardInterrupt:
        emit_error(CliError("interrupted", t("中断されました", "Interrupted"), EXIT_INTERRUPTED),
                   as_json, stderr)
        return EXIT_INTERRUPTED
    except Exception as exc:  # 想定外。型名のみ出し、内容（秘密を含み得る）は出さない
        emit_error(CliError("internal", t("内部エラー（%s）", "Internal error (%s)") % type(exc).__name__,
                            EXIT_INTERNAL), as_json, stderr)
        return EXIT_INTERNAL


if __name__ == "__main__":
    sys.exit(main())
