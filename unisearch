# 設定ファイルの lang（ja / en）で選ぶ。既定は ja。JSON のキー・error.type・終了コードは
# 言語によらず同じ。

LANGUAGES = ("ja", "en")
LANG = "ja"


def t(ja, en):
    """表示する文を、設定の言語で選ぶ。"""
    return en if LANG == "en" else ja


def set_language(lang):
    global LANG
    LANG = lang if lang in LANGUAGES else "ja"


def peek_language(path):
    """設定ファイルから lang だけを読む。読めない・不正なときは ja（エラーは load_settings で出す）。"""
    try:
        with open(path, encoding="utf-8") as handle:
            lines = handle.read().splitlines()
    except (OSError, UnicodeDecodeError):
        return "ja"
    lang = "ja"
    for line in lines:
        name, sep, value = line.strip().partition("=")
        if sep and name.strip().lower() == "lang" and value.strip().lower() in LANGUAGES:
            lang = value.strip().lower()
    return lang


