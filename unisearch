class CliError(Exception):
    """終了コードと分類つきのエラー。message に秘密情報を含めないこと。"""

    def __init__(self, kind, message, exit_code, api_code=None):
        super().__init__(message)
        self.kind = kind
        self.message = message
        self.exit_code = exit_code
        self.api_code = api_code


# ---------------------------------------------------------------- 通信層

def loopback_ssl_context():
    # 127.0.0.1 上のDSM自己署名証明書を検証できないため、ループバック限定で検証を省略。
    return ssl._create_unverified_context()


class HttpTransport:
    """POST して JSON を返す。テストでは同じ call(url, params) を持つ偽物に差し替える。"""

    def __init__(self, timeout):
        self.timeout = timeout
        self.context = loopback_ssl_context()

    def call(self, url, params):
        body = urllib.parse.urlencode(params).encode("utf-8")
        request = urllib.request.Request(url, data=body, method="POST")
        try:
            with urllib.request.urlopen(request, context=self.context,
                                        timeout=self.timeout) as response:
                raw = response.read()
        except urllib.error.HTTPError as exc:
            raise CliError("network", t("HTTPエラー %s", "HTTP error %s") % exc.code, EXIT_NETWORK)
        except (urllib.error.URLError, OSError) as exc:
            reason = getattr(exc, "reason", exc)
            raise CliError("network", t("接続できません: %s", "Cannot connect: %s") % reason,
                           EXIT_NETWORK)
        try:
            return json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, ValueError):
            raise CliError("response", t("APIの応答がJSONではありません", "The API response is not JSON"),
                           EXIT_RESPONSE)


def api_code_of(response):
    error = response.get("error") if isinstance(response, dict) else None
    if isinstance(error, dict):
        return error.get("code")
    return None


def require_dict(response, what):
    if not isinstance(response, dict) or "success" not in response:
        raise CliError("response", t("%sの応答形式が想定外です", "Unexpected %s response format") % what,
                       EXIT_RESPONSE)
    return response


# ---------------------------------------------------------------- API操作

def login(transport, username, password, otp):
    response = require_dict(transport.call(API_URL, {
        "api": AUTH_API, "version": AUTH_VERSION, "method": "login",
        "account": username, "passwd": password, "otp_code": otp,
        "session": SESSION_NAME, "format": "sid",
    }), t("認証", "login"))
    if not response.get("success"):
        code = api_code_of(response)
        hint = AUTH_ERROR_HINTS.get(code)
        message = t("認証失敗（コード %s）", "Login failed (code %s)") % code
        if hint:
            message += t("：%s", ": %s") % t(*hint)
        raise CliError("auth", message, EXIT_AUTH, code)
    data = response.get("data")
    sid = data.get("sid") if isinstance(data, dict) else None
    if not isinstance(sid, str) or not sid:
        raise CliError("response", t("認証応答にセッションIDがありません",
                                      "The login response has no session ID"), EXIT_RESPONSE)
    return sid


def logout(transport, sid):
    """成功なら True。失敗しても例外は投げない（検索結果を優先する）。"""
    try:
        response = transport.call(API_URL, {
            "api": AUTH_API, "version": AUTH_VERSION, "method": "logout",
            "session": SESSION_NAME, "_sid": sid,
        })
    except Exception:
        return False
    return isinstance(response, dict) and bool(response.get("success"))


def build_search_params(query, limit, offset, sid):
    return {
        "api": SEARCH_API, "version": SEARCH_VERSION, "method": "search",
        "keyword": json.dumps(query, ensure_ascii=False),
        "size": str(limit),
        "from": str(offset),
        "search_weight_list": json.dumps(SEARCH_WEIGHT_LIST),
        "fields": json.dumps(SEARCH_FIELDS),
        "sorter_field": json.dumps("relevance"),
        "sorter_direction": json.dumps("asc"),
        "sorter_use_nature_sort": "false",
        "sorter_show_directory_first": "true",
        "_sid": sid,
    }


def search(transport, sid, query, limit, offset):
    response = require_dict(
        transport.call(API_URL, build_search_params(query, limit, offset, sid)), t("検索", "search"))
    if not response.get("success"):
        code = api_code_of(response)
        # 119/120 等の意味は前提に依存するため解釈を付けない（AGENTS.md）。
        raise CliError("api", t("検索失敗（コード %s）", "Search failed (code %s)") % code,
                       EXIT_API, code)
    data = response.get("data")
    if not isinstance(data, dict):
        raise CliError("response", t("検索応答に data がありません", "The search response has no data"),
                       EXIT_RESPONSE)
    hits = data.get("hits", [])
    if not isinstance(hits, list):
        raise CliError("response", t("検索応答の hits が配列ではありません",
                                      "hits in the search response is not a list"), EXIT_RESPONSE)
    return data


def check_api(transport):
    """認証不要の SYNO.API.Info で必要APIの存在とバージョン範囲を確認する。"""
    response = require_dict(transport.call(INFO_URL, {
        "api": "SYNO.API.Info", "version": "1", "method": "query",
        "query": "%s,%s" % (AUTH_API, SEARCH_API),
    }), t("API情報", "API info"))
    if not response.get("success"):
        raise CliError("api", t("API情報の取得失敗（コード %s）", "Could not get API info (code %s)")
                       % api_code_of(response),
                       EXIT_API, api_code_of(response))
    data = response.get("data") or {}
    report = {"schema_version": SCHEMA_VERSION, "ok": True, "apis": {}}
    for name, want in ((AUTH_API, AUTH_VERSION), (SEARCH_API, SEARCH_VERSION)):
        info = data.get(name)
        entry = {"present": isinstance(info, dict), "required_version": int(want)}
        if isinstance(info, dict):
            entry.update({"path": info.get("path"),
                          "min_version": info.get("minVersion"),
                          "max_version": info.get("maxVersion")})
            try:
                entry["supported"] = int(info["minVersion"]) <= int(want) <= int(info["maxVersion"])
            except (KeyError, TypeError, ValueError):
                entry["supported"] = False
        else:
            entry["supported"] = False
        report["apis"][name] = entry
        report["ok"] = report["ok"] and entry["supported"]
    return report


# ---------------------------------------------------------------- 出力整形

def normalize_hit(item):
    if not isinstance(item, dict):
        item = {}
    return {key: convert(item.get(field)) for key, field, convert in HIT_KEY_MAP}


def normalize_prefix(prefix):
    """許可パスの接頭辞を /共有名[/サブパス] の形にそろえる。不正なら None。"""
    if not isinstance(prefix, str) or not prefix.startswith("/") or ".." in prefix.split("/"):
        return None
    cleaned = posixpath.normpath(prefix)
    if cleaned in ("/", "//"):
        return None
    return cleaned


def path_allowed(share_path, prefixes):
    """share_path が接頭辞のどれかと同じか、その配下なら True（/a は /ab に一致しない）。"""
    # ".." は正規化前に拒否する（正規化すると /許可/../他 が /他 に化けるため）
    if (not isinstance(share_path, str) or not share_path.startswith("/")
            or ".." in share_path.split("/")):
        return False
    path = posixpath.normpath(share_path)
    return any(path == prefix or path.startswith(prefix + "/") for prefix in prefixes)


def build_result(query, limit, offset, data):
    """絞り込みなしの結果。offset は API の位置そのまま。"""
    raw_hits = data.get("hits", [])
    hits = [normalize_hit(item) for item in raw_hits]
    unavailable = data.get("unavail")
    return {
        "schema_version": SCHEMA_VERSION,
        "query": query,
        "offset": offset,
        "limit": limit,
        "total": to_int(data.get("total")),
        "returned": len(hits),
        # 次ページの offset。API が limit 件そろえて返したときだけ続きがあり得る
        "next_offset": offset + len(raw_hits) if len(raw_hits) >= limit else None,
        "has_error": to_bool(data.get("has_error")),
        "unavailable": unavailable if isinstance(unavailable, list) else None,
        "hits": hits,
    }


SCAN_PAGE_SIZE = 100    # 絞り込み時に API から1回で読む件数
MAX_SCAN_PAGES = 20     # 1回の検索で読む上限（2,000件）
SCAN_CACHE_SIZE = 32    # 続きのページ用に覚えておく検索語の数
SCAN_TIME_BUDGET = 40   # 1回の検索で読み進める上限秒


def search_filtered(transport, sid, query, limit, offset, prefixes, checkpoints=None,
                    clock=time.monotonic, max_pages=None, time_budget=None):
    """許可範囲内の結果だけでページを作る。

    offset と next_offset は「許可範囲内で何件目か」で数える。API の位置や範囲外の件数は
    結果に出さない（total と unavailable は常に null）。
    checkpoints（dict）を渡すと、検索語ごとに「許可範囲内で何件読んだか・API のどこまで
    読んだか」を覚え、続きのページを途中から読む。
    """
    allowed_seen, raw_pos = 0, 0
    if checkpoints is not None:
        saved = checkpoints.pop(query, None)
        if saved and saved[0] <= offset:
            allowed_seen, raw_pos = saved
    hits = []
    has_error = False
    more = False
    max_pages = max_pages or MAX_SCAN_PAGES
    time_budget = time_budget or SCAN_TIME_BUDGET
    pages = 0
    started = clock()
    while True:
        if pages >= max_pages or (pages and clock() - started > time_budget):
            more = True
            break
        data = search(transport, sid, query, SCAN_PAGE_SIZE, raw_pos)
        pages += 1
        has_error = has_error or bool(to_bool(data.get("has_error")))
        raw_hits = data.get("hits", [])
        stop_at = None
        for index, item in enumerate(raw_hits):
            hit = normalize_hit(item)
            if not path_allowed(hit["share_path"], prefixes):
                continue
            if allowed_seen >= offset:
                if len(hits) == limit:
                    stop_at = index  # 許可範囲内の次の1件。ここから続きを読む
                    break
                hits.append(hit)
            allowed_seen += 1
        if stop_at is not None:
            raw_pos += stop_at
            more = True
            break
        raw_pos += len(raw_hits)
        if len(raw_hits) < SCAN_PAGE_SIZE:
            break  # API の結果の終わり
    if checkpoints is not None:
        checkpoints[query] = (allowed_seen, raw_pos)
        while len(checkpoints) > SCAN_CACHE_SIZE:
            checkpoints.pop(next(iter(checkpoints)))
    if more and not hits:  # 上限まで読んでも1件も見つからず、先へ進めなかった
        raise CliError(
            "scan_limit",
            t("範囲外の結果が多く、指定の位置まで読み進められませんでした。"
              "検索セッションを使っている場合は、同じ呼び出しを繰り返すと続きから読みます",
              "Too many out-of-scope results to reach the requested position. "
              "With a search session, repeat the same call to continue from where it stopped"),
            EXIT_API)
    return {
        "schema_version": SCHEMA_VERSION,
        "query": query,
        "offset": offset,
        "limit": limit,
        "total": None,
        "returned": len(hits),
        "next_offset": offset + len(hits) if more else None,
        "has_error": has_error,
        "unavailable": None,
        "hits": hits,
    }


def sanitize_text(value):
    """端末向け表示で制御文字（エスケープシーケンス等）を無害化する。"""
    text = "" if value is None else str(value)
    return "".join(
        ch if (ch >= " " and not ("\x7f" <= ch <= "\x9f")) else "\\x%02x" % ord(ch)
        for ch in text)


def format_text(result):
    lines = [t("検索: %s / 総件数: %s / 表示: %s", "Query: %s / Total: %s / Shown: %s") % (
        sanitize_text(result["query"]),
        t("不明", "unknown") if result["total"] is None else result["total"],
        result["returned"])]
    for index, hit in enumerate(result["hits"], start=result["offset"] + 1):
        name = hit["name"] if hit["name"] is not None else t("(名称なし)", "(no name)")
        lines.append("%s. %s  %s" % (index, sanitize_text(name),
                                     sanitize_text(hit["share_path"] or "")))
    return "\n".join(lines)


def emit_error(error, as_json, stderr):
    if as_json:
        payload = {"schema_version": SCHEMA_VERSION, "error": {
            "type": error.kind, "message": error.message,
            "api_code": error.api_code, "exit_code": error.exit_code}}
        print(json.dumps(payload, ensure_ascii=False), file=stderr)
    else:
        print(t("エラー: %s", "Error: %s") % error.message, file=stderr)


# ---------------------------------------------------------------- 入力

class TtyPrompter:
    """資格情報は /dev/tty からのみ読む。stdin にフォールバックしない。"""

    def __init__(self, tty_path="/dev/tty"):
        self.tty_path = tty_path

    def _require_tty(self):
        try:
            with open(self.tty_path, "r"):
                pass
        except OSError:
            raise CliError(
                "no_tty",
                t("対話入力用のTTYがありません（ssh -t で実行するか、本人が検索セッションを開始してください）",
                  "No TTY for interactive input (run with ssh -t, or have a person start a "
                  "search session)"),
                EXIT_NO_TTY)

    def username(self):
        self._require_tty()
        # 端末はシーク不可のため "r+" のテキストモードでは開けない。読み書きを分けて開く。
        with open(self.tty_path, "w", encoding="utf-8") as out:
            out.write(t("DSMユーザー名（検索に使う DSM アカウント）: ",
                        "DSM user name (the DSM account used for search): "))
            out.flush()
        with open(self.tty_path, "r", encoding="utf-8") as tty:
            line = tty.readline()
        if not line:
            raise CliError("no_tty", t("ユーザー名を読み取れませんでした", "Could not read the user name"),
                           EXIT_NO_TTY)
        return line.strip()

    def notice(self, text):
        """入力の前に、何を入力するのかを端末に表示する。"""
        self._require_tty()
        with open(self.tty_path, "w", encoding="utf-8") as out:
            out.write(text)
            out.flush()

    def secret(self, label):
        self._require_tty()
        # getpass はロケールの文字コードで見出しを書くため、DSM の C ロケールでは
        # 日本語が「?」に化ける（2026-11-04 実機）。見出しは自前で UTF-8 で書く。
        with open(self.tty_path, "w", encoding="utf-8") as out:
            out.write(label)
            out.flush()
        return getpass.getpass("")


def ask_credentials(prompter, username, purpose):
    """どの DSM アカウントの入力かを示してから、パスワードと2段階認証コードを聞く。"""
    shown = sanitize_text(username)
    notice = getattr(prompter, "notice", None)
    if notice is not None:
        notice(t("\nSynology Universal Search — %s\n"
                 "DSM アカウント: %s\n"
                 "SSH のログイン用ではなく、この DSM アカウントのパスワードと"
                 "2段階認証コードを入力してください。\n",
                 "\nSynology Universal Search — %s\n"
                 "DSM account: %s\n"
                 "Enter the password and 2-step verification code of this DSM account, "
                 "not your SSH login.\n") % (purpose, shown))
    password = prompter.secret(t("%s の DSM パスワード: ", "DSM password for %s: ") % shown)
    otp = prompter.secret(t("%s の2段階認証コード（6桁）: ",
                            "2-step verification code for %s (6 digits): ") % shown)
    return password, otp


