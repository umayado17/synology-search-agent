    {"field": "SYNOMDSearchFileName", "weight": 8.5, "trailing_wildcard": True},
]
SEARCH_FIELDS = [
    "SYNOMDSharePath", "SYNOMDFSName", "SYNOMDFSSize",
    "SYNOMDIsDir", "SYNOMDContentModificationDate",
]
def to_int(value):
    """実機では数値が文字列で返る（例 "4096"）。整数に変換できなければ None。"""
    if isinstance(value, bool):
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, str) and value.strip().lstrip("-").isdigit():
        return int(value.strip())
    return None


def to_bool(value):
    """実機の SYNOMDIsDir は "y"/"n"。それ以外の値は None。"""
    if isinstance(value, bool):
        return value
    if value in ("y", "Y", "yes", "true", "1", 1):
        return True
    if value in ("n", "N", "no", "false", "0", 0):
        return False
    return None


def to_text(value):
    return value if isinstance(value, str) else None


def to_utc_iso(value):
    seconds = to_int(value)
    if seconds is None:
        return None
    try:
        return datetime.datetime.fromtimestamp(
            seconds, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    except (OverflowError, OSError, ValueError):
        return None


# 出力JSONのキー名 ← APIのフィールド名・変換（2026-11-04 実機の応答形式に合わせた）
HIT_KEY_MAP = [
    ("name", "SYNOMDFSName", to_text),
    ("share_path", "SYNOMDSharePath", to_text),   # /<共有フォルダ>/.../<名前>
    ("path", "SYNOMDPath", to_text),              # /volume1/<共有フォルダ>/...（NAS内の絶対パス）
    ("extension", "SYNOMDExtension", to_text),
    ("size", "SYNOMDFSSize", to_int),             # バイト（実機は文字列）
    ("is_dir", "SYNOMDIsDir", to_bool),
    ("modified", "SYNOMDContentModificationDate", to_int),  # UNIX秒（実機は文字列）
    ("modified_utc", "SYNOMDContentModificationDate", to_utc_iso),
    ("readable", "readable", to_bool),
]

# 終了コード（docs/cli-spec.md と一致させること）
EXIT_OK = 0
EXIT_INTERNAL = 1
EXIT_USAGE = 2
EXIT_AUTH = 3
EXIT_API = 4
EXIT_NETWORK = 5
EXIT_RESPONSE = 6
EXIT_NO_TTY = 7
EXIT_SESSION_REQUIRED = 8
EXIT_SESSION_STATE = 9
EXIT_INTERRUPTED = 130

# SYNO.API.Auth の公開資料にある代表的なコード。参考表示のみで断定はしない。
AUTH_ERROR_HINTS = {
    400: "アカウントまたはパスワードが正しくない可能性",
    401: "アカウントが無効化されている可能性",
    402: "権限が拒否された可能性",
